# Copy this file to .env and replace every REPLACE_ME value.
# .env is ignored by git. Never commit real keys and never paste them into a chat tool.

# --- LLM endpoint (OpenAI-compatible) ----------------------------------------
# Base URL of your OpenAI-compatible endpoint. It usually ends in /v1.
# Example for a LiteLLM proxy: https://your-proxy.example.com/v1
OPENAI_BASE_URL=https://REPLACE_ME/v1
# API key for that endpoint. For a LiteLLM proxy this is your virtual key.
OPENAI_API_KEY=REPLACE_ME
# Model name the endpoint expects. For a LiteLLM proxy this is the model alias.
# `python -m bootcamp doctor` lists the models your endpoint offers.
OPENAI_MODEL=REPLACE_ME
# Optional: a different model for the LLM judge. Empty means "use OPENAI_MODEL".
OPENAI_JUDGE_MODEL=

# --- Arize AX (tracing and evals) ---------------------------------------------
# Copy both values from your Arize space settings.
ARIZE_SPACE_ID=REPLACE_ME
ARIZE_API_KEY=REPLACE_ME
# Traces are grouped under this project name in Arize. Use one name per team.
ARIZE_PROJECT_NAME=bootcamp-REPLACE_ME
# Optional: grpc (default) or http. Use http when your network blocks gRPC.
ARIZE_TRANSPORT=grpc
# Optional: endpoint override for another region. With http, give the full
# URL ending in /v1/traces.
ARIZE_ENDPOINT=

# --- Capstone -----------------------------------------------------------------
CAPSTONE_NAME=REPLACE_ME
TEAM_NAME=REPLACE_ME
# Default framework for the command line and the app: maf (Microsoft Agent Framework),
# langgraph or deepagents
AGENT_FRAMEWORK=maf
